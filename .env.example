# Copy this file to .env (which is git-ignored) and change BOTH passwords.
#
# SQL Server requires 8+ characters with at least 3 of: uppercase, lowercase, digit, symbol.
# Avoid these characters: ' " | & \ $ ! (they can break Compose interpolation or the init script).

SA_PASSWORD=Sa-ChangeMe-2026x
MCP_READER_PASSWORD=Reader-ChangeMe-2026x

